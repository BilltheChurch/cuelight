{
  "name": "cuelight",
  "private": true,
  "version": "0.1.0",
  "description": "A teleprompter pinned to your UI: spotlight on the next click, your line right next to it, invisible to screen recorders.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @cuelight/desktop dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "schema": "pnpm --filter @cuelight/schema emit",
    "selftest": "pnpm --filter @cuelight/desktop selftest",
    "e2e": "node scripts/e2e-web.mjs",
    "e2e:editor": "node scripts/e2e-editor.mjs",
    "e2e:ai": "node scripts/e2e-ai.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
